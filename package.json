{
  "name": "bb",
  "version": "0.1.0",
  "private": true,
  "description": "Internal Git and Bitbucket Data Center command-line helper.",
  "type": "module",
  "bin": {
    "bb": "dist/main.js"
  },
  "files": [
    "dist/**/*.js",
    "README.md"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node src/main.ts",
    "build": "node scripts/build.mjs",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "node --test",
    "test:package": "node scripts/check-package.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.8.0"
  },
  "dependencies": {
    "commander": "^15.0.0"
  },
  "bundleDependencies": [
    "commander"
  ]
}
