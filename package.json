{
  "name": "bb",
  "version": "0.1.0",
  "private": true,
  "description": "Internal Git and Bitbucket Data Center command-line helper.",
  "type": "module",
  "bin": {
    "bb": "dist/main.js"
  },
  "files": [
    "dist/**/*.js",
    "README.md",
    "docs/json-output.md"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node src/main.ts",
    "build": "node scripts/build.mjs",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/**/*.test.ts\"",
    "test:package": "node scripts/check-package.mjs",
    "test:git": "node scripts/check-git-install.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run typecheck && npm test"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "prettier": "3.9.10",
    "typescript": "^5.8.0"
  },
  "dependencies": {
    "commander": "^15.0.0"
  },
  "bundleDependencies": [
    "commander"
  ]
}
